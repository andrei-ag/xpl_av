;────────────────────── данные необходимые кодо-анализатору
 ca_ip_percent          db ?
 ca_ip_instr            db ?
 ca_ip_call_off         dd ?

;────────────────────── данные необходимые эмулятору
; temp + 000 - временное хранение значения EFLAGS
; temp + 004 - размер указанного пути для проверки файлов
; temp + 008 - аттрибуты проверяемого файла
; temp + 012 - entry point
; temp + 016 - длина path проверяемого файла
; temp + 020 - найдена сигнатура упаковщика или криптовщика
;              (0-нет, иначе содержит номер найденной по базе сигнатуры)
; temp + 024 - размер файла
; temp + 028 - значение таймера на момент запуска эмулятора
;
 temp                  dd 10 dup (?)
 emul_stop             dd ?                      ; точка остановки эмулятора
                       dd ?                      ; предыдущее смещение эмулятора (перед точкой остановки)

 instr_buf:            db 50 dup (?)             ; буфер под инструкцию и ret (запуск инструкции)
 temp_instr_buf        db 50 dup (?)             ; в этом буфере эмулятором формируются инструкции
;──────────────────────
 temp_pe_buffer        db 1000 dup (?)           ; буфер под PE-заголовок файла
 max_program_size      = 150000000               ; максимальный размер программ
;                                                ; подлежащих проверке (150mb)
;
 virtual_stack_size    = 50000                  ; размер вирт. стэка
;
 virtual_stack_pointer dd ?                      ; указатель на начало
;
; стек для хранения дополнительных данных при эмуляции call 
;
 offset_stack_ptr      dd ?                      ; указатель на конец стека
;──────────────────────
 flags                 dd ?          ; значение флагового регистра EFLAGS
;
; значение виртуальных регистров
;  последовательность расположения в буфере: eax/ecx/edx/ebx/esp/ebp/esi/edi
;
 regs                  dd 9 dup (?)
;
; статус смещения: 0 - смещение, 1 - содержит IP, 2 - содержит STACK
;
 offset_nfo            db ?                  
;
; тип значений содержащихся в виртуальных регистрах: 0-none, 1-ip, 2-stack
;
;
 _regs                 db 09 dup (?)
 _regs_nfo             dd 10 dup (?)         ; значения посчитанных delta value

;────────────────────── disasm data
;  буфер "dregs", используется для хранения информации об инструкциях,
; разобранных "дополнительно".
;
; dregs+000 - количество регистров использующихся в инструкции
;             для указания смещения
; dregs+1*4 - номер первого регистра использующегося для ...
; dregs+n*4 - номер n-ого регистра ...
; dregs+9*4 - номер 9-ого регистра (последний регистр)
;
 dregs                 dd 010 dup (?)       ; см. выше