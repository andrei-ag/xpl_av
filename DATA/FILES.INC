;────────────────────── данные о разбираемом PE-файле
; zero_ot - буфер размером 40 байт, состоящий из нулей
;           используется для затирания данных о секции (при лечении PE-файлов)
;
 zero_ot               db ot_size dup (0)
 eh                    EXEhdr <?>            ; структура под заголовок DOS EXE
 ph_loc                dd ?                  ; смещение заголовка PE в файле
 ph                    PEhdr <?>             ; структура под заголовок PE
;
; ot_loc - смещение (относительно в буфера "all_ot") данных о секции, в
;          которой расположена точка входа
; ot_1st - смещение данных о первой секции (относительно файла)
;
 ot_1st                dd ?
 ot_loc                dd ?
 all_ot                db ot_size*90 dup (?) ; буфер под данные о секциях
