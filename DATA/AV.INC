;────────────────────── данные необходимые антивирусу
;
 scanned               dd 0
 infected              dd 0
 cleaned               dd 0
 deleted               dd 0
 modification          dd 0
;
; метка зараженности: 0-здоров иначе равняется номеру найденного вируса из базе
;
 ill_mark              dd 0
 mask                  db '\*.*',0               ; маска для поиска
 drive_path            db 'a:\',0                ; корневой каталог диска
;
; конфигурация :
;
 cure_result           db 0                  ; 1 - требует удаления
                                             ; 2 - успешно вылечен
 try_cure              db 0                  ; 0 - не производить лечение файлов
                                             ; 1 - лечить зараженные файлы
 report                db 2                  ; 0 - дописывать в конец
                                             ; 1 - пересоздавать файл отчета
                                             ; 2 - не создавать файл отчета
 debug_lst             db 0                  ; 0 - не использовать
                                             ; 1 - файл листинга создан
 debug_mode            db 0                  ; 0 - запуск в нормальном режиме
                                             ; 1 - запуск в отладочном режиме
 emul_timer            db 1                  ; 0/1 - выкл/вкл таймер эмулятора