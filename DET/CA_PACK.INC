; Анализатор кода (c) 2004, beauty on the fire
;
; Часть анализатора кода, отвечающая за поиск сигнатур известных упаковщиков
;
;                                * * *
;
;  Эмулятор этого антивируса предназначен для имитации работы расшифровщиков.
; Основная его задача - расшифровать вирусное тело и сравнить с сигнатурами
; известных вирусов (информация о которых присутствует в базе).
; Однако существуют различные утилиты, которые позволяют упаковать или
; зашифровать код программы (в том числе, вирусных дропперов или программ
; зараженных вирусами). Такими утилитами, часто пользуются, когда
; распространяют вирусы (особенно те, в которых отсутствуют технологии
; полиморфизма или шифровки), в надежде на то, что антивирусы не смогут
; обнаружить вирусы в таких файлах. Подобные утилиты прикрепляют к
; "обработанным" файлам достаточно большие и комплексные декрипторы. Если
; эмулятор антивируса, способен имитировать работу декрипторов создаваемых,
; той или иной утилитой, то при их встрече, размер эмулируемого кода должен
; равняться максимальному размеру декрипторов создаваемых этой утилитой.
;  Очень часто, декрипторы содержат множество сигнатур, которые и могут
; являться критерием встречи с "продуктом" какой либо утилиты.
;
;──────────────────────────────────────────────────────────────────────────────
; структура базы полностью аналогична вирусной базе
;
.data                 ;─────────────────────────── база сигнатур
 pck_no                 dd 1                     ; количество записей в базе
_001_type               db etype_pe
_001_name               db 'UPX'
                        db 022 dup (0)
_001_sig_len            db 006
_001_reserved           dw ?
_001_sig_data           db 060h,0BEh, '?',004d,08Dh,0BEh
                        db 024 dup (0)
_001_cure_loc           dd 0
.code
;──────────────────────────────────────────────────────────────────────────────
; det_pack - проверка на упаковщики и шифровщики
;
; on start :       eax - точка входа в файл
; on exit  :  temp+020 - номер упаковщика в базе данных
;
 det_pack       proc    ftype:dword
;──────────────────────────────────────────────────────────────────────────────
                pushad
;───────────────
                mov     byte ptr [temp+020],0    ; инициализация переменной

                push    ftype
                push    offset pck_no
                push    eax
                call    detect
                or      eax,eax
                jz      det_pack_ret
;───────────────
                mov     byte ptr [temp+020],al
                dec     eax
                mov     edx,entry_size
                mul     edx
                add     eax,offset _001_type+e_type
                push    eax
                push    offset msg_packed
                call    write_string
                call    write_string
                push    offset msg_next
                call    write_string
;
 det_pack_ret:  popad
                ret
 endp
;──────────────────────────────────────────────────────────────────────────────