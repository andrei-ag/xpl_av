; Анализатор кода (c) 2004, beauty on the fire
;
; Часть анализатора кода, отвечающая за поиск процедур подсчета delta_value
;
;                                * * *
;
;  Во многих процедурах дешифровки вирусного кода, используются "процедуры"
; подсчета delta value. Delta value - это число, которое является разницей
; между начальным положением кода в памяти и текущем положением. Т.е.
; подсчитывая его, и прибавляя к смещениям различных "ресурсов", мы всегда
; получим их текущее местоположение.
;  Различные варианты, таких процедур используются в вирусах, так как
; местоположение их кода изменяется в зависимости от файлов, которые они
; заражают. Так же, эти процедуры используются в расшифровщиках большинства
; самошифрующихся вирусов и достаточно часто в вирусах использующих простые
; полиморфные алгоритмы. Это несмотря на то, что наличие таких процедур, плюс
; несколько обнаруженных в декрипторе постоянных участков, позволяют составлять
; достаточно устойчивую сигнатуру расшифровщика, для детектирования с помощью
; "плавающей сигнатуры".
;
;  Процедура подсчета delta_value может выглядеть примерно так:
;
; 1) delta:  call get_ip               delta:  call get_ip
; 2) get_ip: pop  ebp                  get_ip: mov  ebp,dword ptr [esp]
; 3)         sub  ebp,offset get_ip            add  esp,4
;                                              sub  ebp,offset get_ip
;
;  Эмулятор нашего антивируса полностью имитирует выполнение инструкций,
; которые в свой работе обращаются к данным по смещениям. В связи с изменением
; местоположения исследуемого кода в памяти, необходимо рассчитать разницу
; между его оригинальным положением и положением в антивирусном буфере. Эта
; разница добавляется ко всем смещениям, используюшимся в инструкциях и
; является эквивалентом значения, которое вычисляется с помощью процедур
; "delta".
;  Следовательно, если подобные процедуры присуствуют в расшифровщике, то
; один из регистров (в примерах рассмотренных выше это ebp) будет содержать
; delta_value (разницу в местоположении) и если он будет использоваться в
; указании смещений, то эмулятору просто нельзя никаким образом изменять
; смещение.
;
;  Необходимо написать функцию, которая будет отвечать за определение процедуры
; подсчета delta_offset и определения регистра в котором содержится
; подсчитанная разница.
;
;  Самый удобный метод определения процедуры, это поиск по сигнатуре. Но здесь
; тот случай, когда сигнатуру выделить никак нельзя. Во всех случаях
; постоянной остается одна инструкция - "call", точнее сказать только один ее
; байт (первый) - 0E8h. В этом случае попытаемся воспользоваться поиском
; сигнатур другого типа.
;  В процедурах первой всегда выполняется инструкция "CALL", в результате
; стек будет содержать смещение инструкции следующей за ней. Следующей
; инструкцией (или спустя несколько) это значение будет содержать один из
; регистров, который и будет в последующем содержать результат подсчета
; "разницы смещений".
;

;──────────────────────────────────────────────────────────────────────────────
; ca_ip_srch - проверка на процедуры подсчета delta value
;
; on start : esi - смещение исследуемого кода
;
 proc ca_ip_srch
;──────────────────────────────────────────────────────────────────────────────
                pushad
;───────────────
; работа процедуры делится на два этапа
;
; ca_ip_percent - номер этапа, на котором сейчас находится кодо-анализатор
;
                cmp     byte [ca_ip_percent],2
                jz      ca_ip_srch_ret
                cmp     byte [ca_ip_percent],1
                jz      ca_ip_stage_2
;───────────────
; Первый этап
;
; 1) Поиск инструкции CALL (0E8h)
; 2) Сохранение в "ca_ip_call_off" смещения, полученного в результате работы
;    найденной инструкции "CALL".
; 3) ca_ip_percent = 1
;
 ca_ip_stage_1: lodsb
                cmp     al,0e8h
                jnz     ca_ip_srch_ret
                lodsd
                inc     byte [ca_ip_percent]
                mov     dword [ca_ip_call_off],esi
                jmp     ca_ip_srch_ret
;───────────────
; Второй этап: первая часть
;
;  Проверка значений всех регистров, на наличие в них значения совпадающего с
; "ca_ip_call_off".
;  Ведется счетчик инструкций. Если, в течении разбора эмулятором восьми
; инструкций, ни один из регистров не содержит значения - заготовки для
; подсчета delta value. То начинаем с первого этапа - обнуляем "ca_ip_percent".
;
 ca_ip_stage_2: mov     esi,regs
                sub     ecx,ecx
                mov     cl,7+1
 ca_ip_srch_lp: lodsd
                cmp     dword [ca_ip_call_off],eax
                jz      ca_ip_stage_3            ; перейдем ко второй части
                loop    ca_ip_srch_lp
                inc     byte [ca_ip_instr]
                cmp     byte [ca_ip_instr],8
                jnz     ca_ip_srch_ret
                mov     word [ca_ip_percent],0
                mov     dword [ca_ip_call_off],0
                jmp     ca_ip_srch_ret
;───────────────
; Второй этап: вторая часть
;
;  Рассчитаем номер регистра, который содержит delta_value и укажем это в
; таблице информации о регистрах ("_regs").
;  Присвоим значение 2 переменной "ca_ip_percent", это означает, что работа
; этой части кодо-анализатора, для разбираемого файла прекращена.
;
 ca_ip_stage_3: inc     byte [ca_ip_percent]
                sub     eax,eax
                mov     al,7+1
                sub     al,cl
                mov     byte [eax+_regs],1   ; регистр "eax" содержит d_v
;───────────────
 ca_ip_srch_ret:popad
                ret
 endp
;──────────────────────────────────────────────────────────────────────────────
; ca_check_regs - проверка регистров 00regREG на наличие в них значения IP
;
; on start : al - байт типа 00regREG, где reg и REG - значения регистров
;
 proc ca_check_regs         
;──────────────────────────────────────────────────────────────────────────────
                call   two_regs
                cmp    byte [eax+_regs],0
                jz     check_regs_2
                mov    dl,byte [eax+_regs]
                ret
;───────────────
 check_regs_2:  mov    dl,byte [edx+_regs]
                ret
;
 endp
;──────────────────────────────────────────────────────────────────────────────
;  Заполним буфер "_regs_nfo" значениями регистров, содержащих delta_value.
;
; _regs_nfo + 000     - число значений в буфере
; _regs_nfo + 004 ... - значения
;
 proc ca_fill_buf           
;──────────────────────────────────────────────────────────────────────────────
                pushad
                mov    ecx,7+1
                mov    edi,_regs_nfo
                mov    esi,regs
                sub    eax,eax                   ; eax=0-номер проверяемого регистра
                stosd                            ; _regs_nfo = 0
                                                 ; edi = _regs_nfo + 4
;───────────────
 _ca_fill_buf:  cmp    byte [eax+_regs],1        ; регистр содержит значение
                jnz    ca_fill_buf_lp            ; типа 1 (delta_value) ?
;
                push   eax
                mov    eax,dword [esi]           ; eax = значение вирт. регистра
                stosd                            ; занесем в буфре "_regs_nfo"
                pop    eax
                inc    dword [_regs_nfo]         ; увеличим число значений в буфере
 ca_fill_buf_lp:inc    eax                       ; следующий регистр
                add    esi,4                     ;
                loop  _ca_fill_buf
;
                popad
                ret
;
 endp
;──────────────────────────────────────────────────────────────────────────────
;  Если значения виртуальных регистров совпадут с значениями delta value
; содержащимися в буфере "_regs_nfo", установить таким регистрам тип "1"
;
 proc ca_check_buf          
;──────────────────────────────────────────────────────────────────────────────
                mov    edi,_regs_nfo
                cmp    dword [edi],0             ; Буфер "_regs_nfo" пуст ?
                jz     ca_check_bret
;
                pushad
                sub    edx,edx                   ; edx = 0 = номер проверяемого регистра
                mov    ecx,7+1
                add    edi,4                     ; edi = "_regs_nfo + 004"
                mov    esi,regs                  ; esi = значения вирт. регистров
_ca_check_buf:  lodsd
                push   ecx edi
;
                mov    ecx,dword [_regs_nfo]     ; ecx = количество значений DV
 ca_chk_reg:    cmp    dword [edi],eax           ; DV совпадает со значением
                jnz    ca_chk_reg_lp             ; виртуального регистра ?
                mov    byte [edx+_regs],1        ; значит в регистре содержится DV
 ca_chk_reg_lp: add    edi,4                     ; проверим следующие значение DV
                loop   ca_chk_reg
;
                pop    edi ecx
                inc    edx
                loop  _ca_check_buf
                popad
 ca_check_bret: ret
;
 endp
