;══════════════════════
;  1) lea ergA,[ergB+ergC]                 │ 08DHEX, 00reg100, 00rgCrgB
;  2) lea ereg,[dword]                       08DHEX, 00reg101, dword
; 3a) lea ergA,[ergB+dword]                │ 08DHEX, 10rgArgB, dword
; 3b) lea ereg,[ esp+dword]                │ 08DHEX, 10reg100, 00ESPesp, dword
;  4) lea ergA,[ergB+ergC+dword]           │ 08DHEX, 10rgA100, 00rgCrgB, dword
;

 @08D_disasm:   lodsb
                cmp    al,10000000b              ; если значение al
                jnc   _@08D_disasm_3             ; от 10000000b то тип 3 и выше
;
; если значение регистра al, выходит из промежутка:
; 000100b (для lea eax,[rega+regb]) - 111101b (для lea edi,[dword]), значит
; перед нами неизвестная инструкция
;

; проверим промежуток для инструкций первого и второго типа
		cmp    al,100b
                jc     unknown_instr
                cmp    al,111101b
                ja     unknown_instr
                          
; определим тип инструкции - 1 или 2 ?

		push   eax
		call   two_regs
		cmp    dl,101b                   ; В инструкции первого типа не 	
                jnz    @08D_disasm_1             ; может быть 101b

 @08D_disasm_2: call   set_dreg_eax              ; Обработка инструкции второго типа
                pop    eax
		mov    cl,6
		sub    edx,edx               ; достаточно запуска в карантине
                jmp    disasm_ret

 @08D_disasm_1: pop    eax                   ; Первый тип инструкции
                mov    cl,3
                xor    al,10000b             ; уберем мусор
                push   eax                   ; запомним значение "eregA"
                lodsb                        ; проверим регистры eregB и eregC
                call   ca_check_regs         ; на наличие ip и указания на стек
                pop    eax
                mov    byte ptr [eax+_regs],dl                        
                jmp    disasm_ret
 
;
; если значение регистра al, находится в промежутке:
; 10eax100 - 10edi100 (10000100 - 10111100)
; то это инструкция типа "3b" или "4", ее размер равен 7 байт
; иначе это инструкция типа "3a" (размер 6 байт)
;
_@08D_disasm_3: cmp    al,10111111b
                ja     unknown_instr
                xor    al,10000000b
                call   two_regs                  ; eax - "rgA" / edx - "rgB"
                xchg   eax,edx
                sub    edx,edx
                mov    cl,7
                cmp    al,00000100b
                jz     disasm_ret
;
; lea ergA,[ergB+dword]                   │ 08DHEX, 10rgArgB, dword
; ~~
                mov    al,byte ptr [esi-1]
                xor    al,10000000b
                call   two_regs
                mov    dl,byte ptr [edx+_regs]
                mov    byte ptr [eax+_regs],dl
                dec    ecx
                sub    edx,edx
                jmp    disasm_ret